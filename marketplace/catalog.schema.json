{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kerminal signed plugin catalog v1",
  "description": "Detached modern minisign signature covers the original JSON bytes. Host verification additionally enforces trust, HTTPS origins, namespaces, expiry, semantic versions and monotonic sequence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "sequence",
    "publishedAt",
    "expiresAt",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "publishedAt": {
      "type": "integer",
      "minimum": 0
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "version",
          "platforms",
          "api",
          "packageKeyId",
          "archiveUrl",
          "signatureUrl",
          "sha256",
          "archiveBytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "windows_x86_64",
                "windows_aarch64",
                "linux_x86_64",
                "linux_aarch64",
                "macos_x86_64",
                "macos_aarch64"
              ]
            }
          },
          "api": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "major",
              "min_minor"
            ],
            "properties": {
              "major": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "min_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "packageKeyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
          },
          "archiveUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 4096,
            "pattern": "^https://"
          },
          "signatureUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 4096,
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "archiveBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          }
        }
      }
    }
  }
}
